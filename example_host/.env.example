# Copy to .env and fill in. Read by example_host/server.py; a real environment
# variable of the same name wins.

DOCAI_URL=http://localhost:8077

# From the superadmin area: register an application, copy the key it shows once.
# Lost it? Select the application and press "Reissue the API key".
DOCAI_KEY=

# In real software these come from the signed-in user's session. The panel
# inherits the company through the embed and never asks anyone to log in.
COMPANY_ID=acme-gmbh
USER_REF=j.moreau

PORT=8090
