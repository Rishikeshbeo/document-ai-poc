# Nothing in the app reads this file — export these before starting uvicorn.

# Leave MISTRAL_API_KEY unset to run on the offline heuristic provider.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Signs the short-lived session tokens the iframe carries.
DOCAI_SECRET=change-me-before-any-shared-deployment

# The superadmin area at /admin. Unset means the demo default, user1 / 1234,
# which is a shut door rather than a locked one — set a real password here
# before the service is reachable by anyone but you.
DOCAI_ADMIN_USER=user1
DOCAI_ADMIN_PASSWORD=
